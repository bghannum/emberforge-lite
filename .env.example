# Emberforge Lite provider credentials — TEMPLATE ONLY.
#
# Copy this file somewhere OUTSIDE the repository and fill in real keys, then
# point the server at it explicitly:
#
#     emberforge-lite serve --allow-spend --env-file /path/to/your.env
#
# Emberforge Lite never auto-discovers a .env: without --allow-spend it runs
# deterministic offline fakes and spends nothing. Keys are read from the process
# environment or the --env-file you name, and never logged or written anywhere.
#
# Leave a key blank to keep that provider offline (its fake stands in).

# SpriteLab — sprite generation and animation.
SPRITELAB_API_KEY=

# OpenAI — source-sprite image generation (gpt-image-2).
OPENAI_API_KEY=

# ElevenLabs — sound-effect generation.
ELEVENLABS_API_KEY=
